[mysqld]
# Maximum size of one network packet / query / row.
max_allowed_packet = 1G

# Default auth plugin. Already the MySQL 8.0 default.
default_authentication_plugin = caching_sha2_password

# Cap size of a single binlog file so rotation happens often and cleanup is fine-grained.
max_binlog_size = 100M

# Auto-purge binary logs older than 3 days (259200s) to prevent disk exhaustion.
binlog_expire_logs_seconds = 259200

# Background I/O ops-per-second hint for InnoDB flushing. Value tuned for SSD/NVMe.
innodb_io_capacity = 1000

# InnoDB page cache kept in RAM. Sized to hold the entire ~7.5GB database on the 32GB host.
innodb_buffer_pool_size = 8G
